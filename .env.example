# Required before exposing with Tailscale Funnel.
# Use a long random value. All public Omi endpoints live under /omi/{token}/...
OMI_CODEX_BRIDGE_TOKEN=replace-with-long-random-token
# Optional when using scripts: read token from runtime/current-token.txt.
OMI_CODEX_TOKEN_FILE=runtime/current-token.txt

# Default workspace for Codex jobs.
OMI_CODEX_WORKSPACE=F:\ag projects\apps\Omi

# Semicolon-separated allowlist. Jobs outside these directories are rejected.
OMI_CODEX_ALLOWED_WORKSPACES=F:\ag projects\apps\Omi

# Leave disabled unless you truly want voice commands to start Codex immediately.
OMI_CODEX_AUTORUN=0

# If autorun is enabled, only these Omi uid values may start jobs automatically.
# The uid appears in Omi webhook/tool requests. Leave empty until your phone uid is known.
OMI_CODEX_AUTORUN_REQUIRE_TRUSTED_UID=1
OMI_CODEX_TRUSTED_UIDS=
# Optional file fallback used by scripts/start_local_bridge.ps1.
OMI_CODEX_TRUSTED_UIDS_FILE=runtime\trusted-uids.txt

# codex runs the real Codex CLI. mock is useful for offline/local tests.
OMI_CODEX_RUNNER=codex

# Where job database and logs are stored.
OMI_CODEX_RUNTIME_DIR=runtime

# Send queued/running/done status back to the phone without opening the screen.
OMI_CODEX_PHONE_STATUS_UPDATES=1
OMI_ANDROID_EXPAND_NOTIFICATIONS=0
OMI_ANDROID_SLEEP_AFTER_NOTIFY=1
OMI_NOTIFICATION_MODE=auto
