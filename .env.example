# Required before exposing with Tailscale Funnel.
# Use a long random value. All public Omi endpoints live under /omi/{token}/...
OMI_CODEX_BRIDGE_TOKEN=replace-with-long-random-token

# Default workspace for Codex jobs.
OMI_CODEX_WORKSPACE=F:\ag projects\apps\Omi

# Semicolon-separated allowlist. Jobs outside these directories are rejected.
OMI_CODEX_ALLOWED_WORKSPACES=F:\ag projects\apps\Omi

# Leave disabled unless you truly want voice commands to start Codex immediately.
OMI_CODEX_AUTORUN=0

# codex runs the real Codex CLI. mock is useful for offline/local tests.
OMI_CODEX_RUNNER=codex

# Where job database and logs are stored.
OMI_CODEX_RUNTIME_DIR=runtime

